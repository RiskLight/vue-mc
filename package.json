{
    "name": "@risklight/vue-mc",
    "version": "1.0.0",
    "description": "",
    "license": "MIT",
    "main": "vue-mc.js",
    "module": "vue-mc.es.js",
    "type": "module",
    "keywords": [
        "vue",
        "collection",
        "datastore",
        "model",
        "models",
        "store",
        "structures",
        "validation"
    ],
    "files": [
        "validation",
        "vue-mc.js",
        "vue-mc.es.js",
        "src/**/*.d.ts"
    ],
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./vue-mc.es.js",
            "require": "./vue-mc.js"
        },
        "./validation": {
            "types": "./src/Validation/index.d.ts",
            "import": "./validation/index.js",
            "require": "./validation/index.js"
        },
        "./validation/locale": {
            "types": "./src/Validation/locale.d.ts",
            "import": "./validation/locale.js",
            "require": "./validation/locale.js"
        }
    },
    "typesVersions": {
        "*": {
            "validation": [
                "./src/Validation/index.d.ts"
            ],
            "validation/locale": [
                "./src/Validation/locale.d.ts"
            ]
        }
    },
    "bugs": {
        "url": "https://github.com/FiguredLimited/vue-mc/issues"
    },
    "homepage": "https://github.com/FiguredLimited/vue-mc",
    "repository": {
        "type": "git",
        "url": "https://github.com/FiguredLimited/vue-mc.git"
    },
    "author": {
        "name": "Rudi Theunissen",
        "email": "rudi.theunissen@figured.com",
        "url": "https://github.com/rtheunissen"
    },
    "dependencies": {
        "axios": "^1.7.0",
        "date-fns": "^4.1.0",
        "lodash": "^4.17.15",
        "validator": "^13.0.0"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.8",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@types/lodash": "^4.14.145",
        "@types/node": "^10.12.0",
        "@types/validator": "^9.4.2",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "array-permutation": "^0.2.0",
        "chai": "^4.2.0",
        "eslint": "^9.39.4",
        "moxios": "^0.4.0",
        "rollup": "^3.30.0",
        "rollup-plugin-babel": "^4.0.3",
        "rollup-plugin-commonjs": "^10.0.2",
        "rollup-plugin-node-resolve": "^5.2.0",
        "rollup-plugin-typescript2": "^0.36.0",
        "ts-node": "^8.0.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0",
        "vue": "^3.5.30"
    },
    "scripts": {
        "build": "rollup -c",
        "lint": "eslint ./src/**/*.ts",
        "test": "vitest run",
        "docs": "cd docs && jekyll serve",
        "prepublishOnly": "yarn build"
    }
}
